meta {
  name: List Export Jobs
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/reconciliations/{{run_id}}/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Returns all export jobs for this run in reverse chronological order.
  Use to track export history or find a previous export job_id.
}
