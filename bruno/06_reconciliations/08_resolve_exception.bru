meta {
  name: Resolve Exception
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/reconciliations/{{run_id}}/exceptions/{{exception_id}}/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "status": "RESOLVED",
    "note": "Confirmed with treasury team. Amount matches but bank booked it a day later."
  }
}

docs {
  Human resolution of an exception.

  status:
  - "RESOLVED" → exception has been investigated and closed
  - "WAIVED"   → accepted as a known difference (e.g. timing, rounding)

  note: Optional resolution comment.
  Action is logged in audit trail.
}
