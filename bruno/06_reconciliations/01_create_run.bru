meta {
  name: Create Reconciliation Run
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/reconciliations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "January 2024 Stripe vs Bank",
    "source_file_id": "{{file_id}}",
    "target_file_id": "{{file_id}}"
  }
}

docs {
  Creates a reconciliation run connecting SOURCE and TARGET files.
  Both files must be fully normalized first (status = NORMALIZED).

  - source_file_id: payment gateway file (Stripe, Razorpay, etc.)
  - target_file_id: bank statement or settlement report

  Raises 409 if either file is not yet normalized.
  Run starts in PENDING status. Call /execute to start matching.
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("run_id", res.body.data.id);
  }
}
