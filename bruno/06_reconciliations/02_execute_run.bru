meta {
  name: Execute Run
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/reconciliations/{{run_id}}/execute
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Triggers the deterministic matching engine.

  Matching strategy cascade (in order):
  1. EXACT_ID   (score 100) — transaction_id / UTR / payment_id exact match
  2. AMOUNT_DATE (score 92) — exact amount + date within 5-day settlement window
  3. AMOUNT_ONLY (score 78) — exact amount, date window exceeded → PENDING_REVIEW
  4. FUZZY_AMOUNT (score 62) — amount within 5% tolerance → PENDING_REVIEW
  5. No match → ExceptionItem created (UNMATCHED_SOURCE or UNMATCHED_TARGET)

  Idempotent guard: raises 409 if run is already COMPLETED.
  Returns COMPLETED run with matched_count, exception_count, match_rate_pct.
}
