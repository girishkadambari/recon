meta {
  name: Review Match
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/reconciliations/{{run_id}}/matches/{{match_id}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "action": "APPROVED",
    "note": "Amounts match. Date difference is within expected settlement window."
  }
}

docs {
  Human review decision on a match candidate.

  action:
  - "APPROVED" → match is confirmed by a human reviewer
  - "REJECTED" → match is manually rejected (creates an exception)

  note: Optional reviewer comment (max 500 chars)
  Action is logged in audit trail.
}
