meta {
  name: Dev Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/dev-login
  body: json
  auth: none
}

body:json {
  {
    "email": "alice@acme.com"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("access_token", res.body.data.access_token);
    bru.setEnvVar("workspace_id", res.body.data.workspace_id);
  }
}
